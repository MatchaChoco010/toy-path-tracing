prefix_rule(
  pattern = ["git", "push"],
  decision = "forbidden",
  justification = "git push is prohibited in this repository.",
  match = [
    "git push",
    "git push origin main",
    "git push --force-with-lease",
  ],
)

prefix_rule(
  pattern = ["git"],
  decision = "allow",
  match = [
    "git status",
    "git diff",
    "git log --oneline",
    "git commit -m test",
    "git checkout main",
    "git switch main",
    "git fetch origin",
    "git pull --ff-only",
    "git branch --show-current",
    "git merge feature/dielectric-ggx",
    "git rebase main",
  ],
)
