ocio_profile_version: 2.5

environment:
  {}
search_path: luts
strictparsing: true
luma: [0.2126, 0.7152, 0.0722]
name: linear-srgb-reinhard
description: Linear sRGB rendering config with a Reinhard display view.

roles:
  aces_interchange: ACES2065-1
  cie_xyz_d65_interchange: CIE XYZ-D65 - Display-referred
  color_picking: sRGB - Texture
  color_timing: ACEScct
  compositing_linear: Linear sRGB
  compositing_log: ACEScct
  data: Raw
  default: sRGB - Texture
  rendering: Linear sRGB
  scene_linear: Linear sRGB
  texture_paint: sRGB - Texture

file_rules:
  - !<Rule> {name: ColorSpaceNamePathSearch}
  - !<Rule> {name: Default, colorspace: sRGB - Texture}

shared_views:
  - !<View> {name: Reinhard, view_transform: Reinhard, display_colorspace: sRGB - Display}
  - !<View> {name: Raw, colorspace: Raw}

displays:
  sRGB - Display:
    - !<Views> [Reinhard, Raw]

active_displays: [sRGB - Display]
active_views: [Reinhard, Raw]

default_view_transform: Reinhard

view_transforms:
  - !<ViewTransform>
    name: Reinhard
    family: Tone Mapping
    from_scene_reference: !<GroupTransform>
      children:
        - !<RangeTransform> {min_in_value: 0, max_in_value: 16, min_out_value: 0, max_out_value: 1}
        - !<FileTransform> {src: reinhard_33.cube, interpolation: linear}

display_colorspaces:
  - !<ColorSpace>
    name: sRGB - Display
    family: Display
    equalitygroup: ""
    bitdepth: 32f
    isdata: false
    encoding: sdr-video
    allocation: uniform
    from_display_reference: !<GroupTransform>
      children:
        - !<ExponentWithLinearTransform> {gamma: 2.4, offset: 0.055, direction: inverse}
        - !<RangeTransform> {min_in_value: 0, max_in_value: 1, min_out_value: 0, max_out_value: 1}

  - !<ColorSpace>
    name: CIE XYZ-D65 - Display-referred
    aliases: [cie_xyz_d65_display]
    family: Interchange
    equalitygroup: ""
    bitdepth: 32f
    isdata: false
    encoding: display-linear
    allocation: uniform
    to_display_reference: !<MatrixTransform> {matrix: [3.240969941905, -1.53738317757, -0.498610760293, 0, -0.969243636281, 1.875967501508, 0.041555057407, 0, 0.055630079697, -0.203976958889, 1.056971514243, 0, 0, 0, 0, 1]}

colorspaces:
  - !<ColorSpace>
    name: Linear sRGB
    aliases: [linear_srgb, lin_srgb, lin_rec709]
    family: Rendering
    equalitygroup: ""
    bitdepth: 32f
    isdata: false
    encoding: scene-linear
    allocation: uniform
    allocationvars: [0, 16]

  - !<ColorSpace>
    name: sRGB - Texture
    aliases: [srgb_texture, srgb]
    family: Texture
    equalitygroup: ""
    bitdepth: 32f
    isdata: false
    encoding: sdr-video
    allocation: uniform
    to_scene_reference: !<ExponentWithLinearTransform> {gamma: 2.4, offset: 0.055}

  - !<ColorSpace>
    name: Raw
    family: Utility
    equalitygroup: ""
    bitdepth: 32f
    isdata: true
    encoding: data
    allocation: uniform

  - !<ColorSpace>
    name: ACES2065-1
    family: Interchange
    equalitygroup: ""
    bitdepth: 32f
    isdata: false
    encoding: scene-linear
    allocation: lg2
    allocationvars: [-10, 6, 0.00390625]
    to_scene_reference: !<GroupTransform>
      children:
        - !<BuiltinTransform> {style: ACEScg_to_ACES2065-1, direction: inverse}
        - !<BuiltinTransform> {style: UTILITY - ACES-AP1_to_LINEAR-REC709_BFD}

  - !<ColorSpace>
    name: ACEScct
    family: Log
    equalitygroup: ""
    bitdepth: 32f
    isdata: false
    encoding: log
    allocation: uniform
    to_scene_reference: !<GroupTransform>
      children:
        - !<BuiltinTransform> {style: ACEScct_to_ACES2065-1}
        - !<GroupTransform>
          children:
            - !<BuiltinTransform> {style: ACEScg_to_ACES2065-1, direction: inverse}
            - !<BuiltinTransform> {style: UTILITY - ACES-AP1_to_LINEAR-REC709_BFD}
